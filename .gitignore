# --- Raw PISA source data -------------------------------------------------
# The SAS exports (4.1 GB student, 40 MB school) are too large for git even
# via LFS. Download from the OECD PISA 2022 database and convert to parquet;
# the parquet conversions themselves are tracked via LFS (see .gitattributes).
data/old/*
data/spss/*

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.Python
build/
dist/
*.egg-info/
.venv/
venv/

# --- Tooling caches -------------------------------------------------------
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
